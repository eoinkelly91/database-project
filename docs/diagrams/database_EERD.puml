@startuml
!theme plain
skinparam linetype ortho
hide circle
hide empty members

' ==========================================
' STORE INFRASTRUCTURE
' ==========================================
entity "FURNITURE_WORLD" as store {
  * store_id : INT <<PK>>
  --
  * store_name : VARCHAR(100)
}

entity "DEPARTMENT" as dept {
  * department_id : INT <<PK>>
  --
  * store_id : INT <<FK>>
  * department_name : VARCHAR(50)
}

entity "WAREHOUSE" as warehouse {
  * warehouse_id : INT <<PK>>
  --
  * store_id : INT <<FK>>
}

' ==========================================
' EMPLOYEE HIERARCHY
' ==========================================
entity "EMPLOYEE" as emp {
  * employee_id : INT <<PK>>
  --
  * first_name : VARCHAR(50)
  * last_name : VARCHAR(50)
  * salary : DECIMAL(10,2)
  * role : VARCHAR(30)
}

entity "MAINTENANCE" as maint {
  * employee_id : INT <<PK, FK>>
}

entity "MANAGER" as manager {
  * employee_id : INT <<PK, FK>>
  --
  * store_id : INT <<FK>>
}

entity "CLERK" as clerk {
  * employee_id : INT <<PK, FK>>
  --
  * clerk_type : VARCHAR(20)
}

entity "STORE_CLERK" as s_clerk {
  * employee_id : INT <<PK, FK>>
}

entity "BLINDS_CLERK" as b_clerk {
  * employee_id : INT <<PK, FK>>
}

entity "DELIVERY_DRIVER" as driver {
  * employee_id : INT <<PK, FK>>
}

' ==========================================
' STOCK HIERARCHY
' ==========================================
entity "STOCK" as stock {
  * stock_id : INT <<PK>>
  --
  * department_id : INT <<FK>>
  * warehouse_id : INT <<FK>>
  * stock_name : VARCHAR(100)
  size : VARCHAR(50)
  colour : VARCHAR(30)
  brand : VARCHAR(50)
  price : DECIMAL(10,2)
  discount : DECIMAL(5,2)
  quantity : INT
  warehouse_location : VARCHAR(50)
}

entity "FURNITURE" as furniture {
  * stock_id : INT <<PK, FK>>
  --
  * furniture_type : CHAR(1)
}

entity "BEDROOM" as bedroom {
  * stock_id : INT <<PK, FK>>
}

entity "LIVING_ROOM" as living_room {
  * stock_id : INT <<PK, FK>>
}

entity "KITCHEN" as kitchen {
  * stock_id : INT <<PK, FK>>
}

entity "FLOORING" as flooring {
  * stock_id : INT <<PK, FK>>
}

entity "BATHROOM" as bathroom {
  * stock_id : INT <<PK, FK>>
}

entity "BLINDS" as blinds {
  * stock_id : INT <<PK, FK>>
  --
  * blind_type : VARCHAR(30)
  specification : TEXT
}

' ==========================================
' EXTERNAL ACTORS & ASSOCIATIVE ENTITIES
' ==========================================
entity "CUSTOMER" as customer {
  * customer_id : INT <<PK>>
}

entity "BLIND_MANUFACTURER" as manufacturer {
  * manufacturer_id : INT <<PK>>
}

entity "ORDER" as ord {
  * order_id : INT <<PK>>
  --
  * stock_id : INT <<FK>>
  * employee_id : INT <<FK>>
  * customer_id : INT <<FK>>
}

entity "SPECIFICATION" as spec {
  * spec_id : INT <<PK>>
  --
  * employee_id : INT <<FK>>
  * manufacturer_id : INT <<FK>>
}

' ==========================================
' RELATIONSHIPS & CARDINALITIES
' ==========================================

store ||--|{ dept : "HAS"
store ||--|{ warehouse : "HAS"
manager }|--|| store : "OVERSEES"

dept ||--|{ stock : "SHOWCASES"
warehouse ||--|{ stock : "STORED IN"
warehouse ||--o{ maint : "MAINTAINS"

' Employee Disjoint Subtypes (d)
emp <|-- maint
emp <|-- manager
emp <|-- clerk
emp <|-- driver

' Clerk Disjoint Subtypes (d)
clerk <|-- b_clerk
clerk <|-- s_clerk

' Stock Disjoint Subtypes (d)
stock <|-- furniture
stock <|-- flooring
stock <|-- bathroom
stock <|-- blinds

' Furniture Disjoint Subtypes (d)
furniture <|-- bedroom
furniture <|-- living_room
furniture <|-- kitchen

' Associative Entities & Operations
ord }|--|| stock
ord }|--|| clerk
ord }|--|| customer

spec }|--|| b_clerk
spec }|--|| manufacturer

driver }|--|{ customer : "DELIVERS ORDER"
manufacturer ||--o{ blinds : "PRODUCES"

@enduml